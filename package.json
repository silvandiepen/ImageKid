{
  "name": "imagekid-monorepo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "site": "npm run site:dev",
    "site:dev": "npm run dev -w apps/website",
    "site:build": "npm run build -w apps/website",
    "native:build": "cd apps/native-macos && swift build",
    "native:test": "cd apps/native-macos && swift test",
    "native:run": "cd apps/native-macos && swift run ImageKid",
    "native:clean": "cd apps/native-macos && swift package clean"
  }
}
