<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements for the bundled Python interpreter, which runs as its own
	  process and therefore does not inherit the app's.

	  Without disable-library-validation here, dyld refuses to map the runtime's
	  own dylibs into it: "mapping process and mapped file (non-platform) have
	  different Team IDs". The app having that entitlement is not enough — the
	  check applies to the process doing the loading.

	  `inherit` gives the worker the app's sandbox rather than a fresh one, so
	  it can read the job workspace and the App Group the app already opened.
	  It is only valid for a process the sandboxed app spawns itself, which is
	  exactly how the worker is launched.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
