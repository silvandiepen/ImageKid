<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sandboxing is off until the Python worker is packaged inside the bundle:
	  a sandboxed process may only execute binaries it ships with, and Sculptor
	  currently launches a developer-provided interpreter. See project.yml.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hakobs.imagekid</string>
	</array>
</dict>
</plist>
